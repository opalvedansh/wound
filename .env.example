# Copy to .env and fill in. Never commit .env.
# Server-only values must never use a NEXT_PUBLIC_ or EXPO_PUBLIC_ prefix —
# anything with those prefixes is bundled into the web/mobile client.

# --- Public (safe to ship to clients) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (API / web server) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=
DIRECT_URL=
