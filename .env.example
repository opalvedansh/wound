# Copy to .env and fill in. Never commit .env.
# Server-only values must never use a NEXT_PUBLIC_ or EXPO_PUBLIC_ prefix —
# anything with those prefixes is bundled into the web/mobile client.

# --- Public (safe to ship to clients) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (API / web server) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
# Runtime: Supabase transaction pooler (port 6543). Migrations: session pooler (port 5432).
DATABASE_URL=
DIRECT_URL=

# --- NestJS API (apps/api) ---
PORT=3333
# Browser origins allowed to call the API: the portal, and the app's web build (Expo).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000
# Cache, rate limits, job queue and audit buffer. Local: docker run -d --name wound-redis -p 6380:6379 redis:7
# Production: Upstash (rediss://...). Without it the API still works: no cache, jobs run inline.
REDIS_URL=redis://localhost:6380
# Database connections per API instance (pooled by Supabase).
DB_POOL_MAX=10
# Background jobs: 1 = this process runs them (default); 0 = web only. WORKER_ONLY=1 = jobs only, no HTTP.
RUN_WORKERS=1
WORKER_ONLY=0
# Signs share-link tokens (only a hash is stored). Long random string; changing it voids existing links.
SHARE_LINK_SECRET=
# Public address of this API (share links point here) and of the portal (invite emails link to its sign-in).
PUBLIC_API_URL=http://localhost:3333/api
PORTAL_URL=http://localhost:3000
# Optional: requests per user per minute (default 300).
# RATE_LIMIT_PER_MINUTE=300

# --- Wound model service (wound-ai/api/server.py) ---
# Only the NestJS API holds this key; never give it a NEXT_PUBLIC_ or EXPO_PUBLIC_ prefix.
# Start the model with the same value: WOUND_API_KEY=... uvicorn api.server:app --port 8000
WOUND_API_URL=http://localhost:8000
WOUND_API_KEY=

# --- Web portal (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# --- Mobile app (apps/mobile/.env) ---
# On a phone, use the computer's LAN address (http://192.168.x.x:3333/api), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3333/api
