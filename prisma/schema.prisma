// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String    @id // Matches auth.users.id
  email     String    @unique
  firstName String
  lastName  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  patients  Patient[]
}

model Patient {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  firstName   String
  lastName    String
  patientId   String   @unique
  sex         String
  dateOfBirth DateTime
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cases       Case[]
}

model Case {
  id            String      @id @default(uuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  onset         DateTime
  location      String
  woundType     String
  comorbidities String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  treatments    Treatment[]
}

model Treatment {
  id        String    @id @default(uuid())
  caseId    String
  case      Case      @relation(fields: [caseId], references: [id])
  therapy   String[]
  dressing  String?
  nextVisit DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  phases    Phase[]
}

model Phase {
  id          String              @id @default(uuid())
  treatmentId String
  treatment   Treatment           @relation(fields: [treatmentId], references: [id])
  phaseType   String // "PRE" or "POST"
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assessment  ClinicalAssessment?
  image       Image?
  aiResult    AIResult?
}

model ClinicalAssessment {
  id                 String   @id @default(uuid())
  phaseId            String   @unique
  phase              Phase    @relation(fields: [phaseId], references: [id])
  exudateLevel       String
  exudateType        String?
  infectionSigns     String[]
  painLevel          Int
  edgeCondition      String?
  periwoundCondition String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Image {
  id        String   @id @default(uuid())
  phaseId   String   @unique
  phase     Phase    @relation(fields: [phaseId], references: [id])
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIResult {
  id               String   @id @default(uuid())
  phaseId          String   @unique
  phase            Phase    @relation(fields: [phaseId], references: [id])
  area             Float?
  length           Float?
  height           Float?
  majorAxis        Float?
  minorAxis        Float?
  shapeAnalysis    String?
  tissuePercentage Json? // For Phase 2
  confidenceScore  Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AssessmentQuestion {
  id           String   @id @default(uuid())
  title        String           // "WOUND TYPE"
  type         String           // "chip_single" | "chip_multi" | "numeric"
  options      Json?            // string[] for chip questions
  required     Boolean  @default(false)
  order        Int      @default(0)
  active       Boolean  @default(true)
  followUpOnly Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
